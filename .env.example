# Todas server-side. Nunca prefixe com NEXT_PUBLIC_.
DATABASE_URL=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Só para testes locais contra uma Pluggy falsa. Em produção, não defina.
# PLUGGY_API_URL=
GEMINI_API_KEY=
# Nome do modelo (não há padrão no código). As duas juntas ligam as sugestões da IA.
GEMINI_MODEL=
# Só para testes locais contra um Gemini falso.
# GEMINI_API_URL=
# Cotações (brapi.dev, plano gratuito): uma requisição por ativo, uma vez por dia, no cron.
BRAPI_TOKEN=
# Só para testes locais contra servidores falsos da brapi e do SGS. Em produção, não defina.
# BRAPI_API_URL=
# SGS_API_URL=
# Web Push: gere com `npx web-push generate-vapid-keys`. As três juntas ligam as notificações.
# A pública vai ao navegador para a inscrição; a privada nunca sai do servidor. SUBJECT: mailto:voce@exemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Mínimo 32 caracteres. O serviço de cron usa o mesmo valor, mais APP_URL.
CRON_SECRET=
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
AUTH_SECRET=
# Seu acesso. O usuário é criado/atualizado quando o servidor sobe; o 2FA é configurado no primeiro login.
LOGIN_USERNAME=
LOGIN_PASSWORD=
